{
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/(lib|android|ios|windows|linux|test|pubspec\\.yaml|pubspec\\.lock|analysis_options\\.yaml|README\\.md|\\.gitignore|\\.metadata|vercel\\.json)(/.*)?$",
      "status": 403,
      "statusText": "Forbidden"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/build/web/assets/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "dest": "/build/web/canvaskit/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/build/web/icons/$1"
    },
    {
      "src": "/(favicon\\.png|manifest\\.json|main\\.dart\\.js|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|version\\.json)",
      "dest": "/build/web/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/build/web/index.html"
    }
  ]
}
